# ── LLM providers ─────────────────────────────────────────────────────────
# The models of the campaign are declared in models.json; each entry names,
# through `api_key_env`, the variable below that holds its key.
# gpt-4.1-mini and gpt-5:
OPENAI_API_KEY=
# llama-3.3-70b-instruct and qwen3.5-9b:
OPENROUTER_API_KEY=

# ── Who is reading the answers ───────────────────────────────────────────
# The expert verdict is the primary outcome, and one reader cannot report
# agreement with anyone. A second annotator sets ENVIROO_EVALUATOR=E2 (or
# passes `evaluator` from the UI) and judges the same runs: observations are
# keyed by (run_id, evaluator), so the two readings coexist instead of the
# second overwriting the first. In metrics.csv the primary evaluator writes
# `manual_verdict` and anyone else writes `manual_verdict_2`; observatii.csv
# keeps every reader's verdict with its own note, and is what an agreement
# statistic should be computed from.
ENVIROO_EVALUATOR=E1
ENVIROO_EVALUATOR_PRIMARY=E1

# ── Which route the models are reached by ────────────────────────────────
# The study's claim is that one gateway serves every model, so that the client,
# the request format, the retry policy and the network path are shared and the
# model is the only thing that changes between arms. That holds only if the
# commercial pair goes through the gateway too.
#   gateway (default) every model through OpenRouter, on OPENROUTER_API_KEY
#   direct            each model with a `route_direct` block in models.json
#                     uses it instead - the GPT pair then goes straight to
#                     api.openai.com on OPENAI_API_KEY
# OpenRouter lists the two GPT models at the prices OpenAI does, so the route
# does not move the cost analysis. It does change `provider_upstream`, and a
# campaign that mixes the two routes is not one campaign: every result row
# records `model_route`. Restart the web server after changing this.
ENVIROO_MODEL_ROUTE=gateway

# ── Routing and geocoding provider ───────────────────────────────────────
# OpenRouteService: walking routes, walking-time polygons, address lookup.
# Free key at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# ── PostGIS ───────────────────────────────────────────────────────────────
# ENVIROO reads its own schema (built by db/etl_*.py) and never writes to the
# source inventory. Keep the password in the local .env only, never in Git.
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgis
PGUSER=postgres
PGPASSWORD=change_me
PGSSLMODE=prefer
PGPOOL_MIN_SIZE=1
PGPOOL_MAX_SIZE=10

# Schema built by the ETL, and the read-only source table it is built from.
ENVIROO_SCHEMA=enviroo
ENVIROO_SOURCE_TABLE=public.adaposturi

# ── Tool behaviour (experimental apparatus — change deliberately) ─────────
# Fraction of nominal capacity credited to a partially functional shelter.
ENVIROO_PARTIAL_CAPACITY_FACTOR=0.5
# Largest polygon accepted by shelters_in_area / population_in_area, in km².
ENVIROO_MAX_AREA_KM2=150
# When true, shelter_service_area answers only from precomputed combinations
# and returns `not_precomputed` otherwise, instead of computing on first use.
ENVIROO_STRICT_PRECOMPUTE=false

# ── MCP server registry (comma-separated, fallback only) ─────────────────
# At runtime the list lives in mcp_servers.json, editable from the UI.
MCP_SERVERS=http://localhost:9100/mcp
# Hosts accepted when a server is added from the UI (anti-SSRF).
# Empty = no restriction (fine locally). In production: localhost,127.0.0.1
MCP_ALLOWED_HOSTS=

# ── Ports ─────────────────────────────────────────────────────────────────
ENVIROO_MCP_HOST=0.0.0.0
ENVIROO_MCP_PORT=9100
ENVIROO_WEB_PORT=8090

# Cache provider answers (geocoding, routing, isochrones) between calls.
# false = every run hits OpenRouteService afresh: no stale geometry, but
# provider latency lands inside the measured turn duration (M16) and the
# free-tier daily quota is consumed by every repetition.
ENVIROO_PROVIDER_CACHE=false

# Use a provider's reasoning field as the answer when `content` comes back
# empty. false = an empty content is an empty answer, which is what a user
# of an OpenAI-compatible client actually sees. The reasoning text is logged
# either way, so the two cases stay distinguishable.
ENVIROO_REASONING_FALLBACK=false

# Which description set the MCP server publishes. The descriptions ARE the
# experimental apparatus, so this is an independent variable:
#   rich    - the full text: when to prefer a neighbouring tool, what to ask
#             for, the cues that map colloquial language onto enum values,
#             how to report honestly. ~7500 characters over 9 tools.
#   minimal - what an API reference would carry, nothing more. ~1200.
# Restart the MCP server after changing this. Every result row records the
# regime it ran under, and run ids carry a `__min` tag under the minimal set.
ENVIROO_TOOL_DESCRIPTIONS=rich

# The two guidance layers that are NOT the apparatus under test, and are held
# constant across the arms so that `rich` and `bare` differ in their published
# descriptions and in nothing else.
#
# Guidance inside tool responses: an error's `message`, a result's `note`. The
# service produces these at runtime and does not publish them as documentation.
#   on   (default) every regime receives them
#   off            no regime receives them
#   auto           legacy: they follow ENVIROO_TOOL_DESCRIPTIONS
# Restart the MCP server after changing this; /health reports the value in use.
ENVIROO_GUIDANCE_RUNTIME=on

# Which system prompt the client sends.
#   shared (default) one prompt for every regime, so the prompt is not a second
#                    experimental factor alongside the descriptions
#   legacy           the guided prompt under `rich`, the thin one elsewhere -
#                    the pairing the first campaign ran under
# Every result row records this and the hash of the prompt actually sent, so a
# campaign can be checked rather than trusted to have held it constant.
ENVIROO_SYSTEM_PROMPT=shared

# Ports of the reduced description arms. Each runs as its own process with the
# same tools and the same data; only the published text differs.
ENVIROO_MCP_PORT_MINIMAL=9101
ENVIROO_MCP_PORT_BARE=9102
